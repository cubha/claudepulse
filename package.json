{
  "name": "claude-code-gauge",
  "displayName": "AgentVitals — Claude Code & Codex Usage",
  "description": "Claude Code & Codex usage, cost and rate limits inside your editor — gauges, burn rate, per-skill cost and Git branch ROI, for both agents.",
  "version": "0.2.2",
  "publisher": "cubha",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cubha/claudepulse.git"
  },
  "homepage": "https://github.com/cubha/claudepulse#readme",
  "bugs": {
    "url": "https://github.com/cubha/claudepulse/issues"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "claude-max",
    "anthropic",
    "codex",
    "openai",
    "gauge",
    "claude-code-gauge",
    "claudepulse",
    "rate-limit",
    "usage",
    "cost",
    "dashboard",
    "monitor",
    "burn-rate"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeCodeGauge",
          "title": "AgentVitals",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claudeCodeGauge": [
        {
          "type": "webview",
          "id": "claudeCodeGauge.sidebar",
          "name": "AgentVitals"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeCodeGauge.openDashboard",
        "title": "AgentVitals: Open Dashboard"
      },
      {
        "command": "claudeCodeGauge.refresh",
        "title": "AgentVitals: Refresh"
      },
      {
        "command": "claudeCodeGauge.login",
        "title": "AgentVitals: Login with Claude"
      },
      {
        "command": "claudeCodeGauge.loginCodex",
        "title": "AgentVitals: Login with Codex"
      }
    ],
    "configuration": {
      "title": "AgentVitals",
      "properties": {
        "claudeCodeGauge.credentialsPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to Claude Code credentials file. Leave empty to use default (~/.claude/.credentials.json)."
        },
        "claudeCodeGauge.pollIntervalMs": {
          "type": "number",
          "default": 300000,
          "description": "How often to poll the Anthropic API for rate limit data (ms). Default: 300000 (5 min)."
        },
        "claudeCodeGauge.usageRefreshIntervalMs": {
          "type": "number",
          "default": 15000,
          "minimum": 3000,
          "description": "Minimum interval between usage recalculations from ~/.claude jsonl logs (ms). The sidebar and dashboard refresh at most this often while a Claude Code session is writing. Default: 15000 (15s). The refresh button always bypasses this."
        },
        "claudeCodeGauge.utilizationWarnThreshold": {
          "type": "number",
          "default": 0.8,
          "minimum": 0,
          "maximum": 1,
          "description": "Show a warning when utilization exceeds this value (0–1). Default: 0.8 (80%)."
        },
        "claudeCodeGauge.retroCommitScope": {
          "type": "string",
          "enum": [
            "mine",
            "all"
          ],
          "enumDescriptions": [
            "Only commits authored by your git config user.email, among those reachable from the current branch (default).",
            "Every commit on the current branch — your usage may be attributed to other people's commits."
          ],
          "default": "mine",
          "description": "Which commits the usage×git retrospective may attribute cost to. Repositories with no user.email configured fall back to 'all' automatically, and the retrospective says so.",
          "scope": "window"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs && tsc --noEmit && tsc --noEmit -p tsconfig.webview.json",
    "watch": "node esbuild.config.mjs --watch",
    "lint": "eslint src --ext ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vscode-test",
    "test:e2e": "esbuild test/integration/broadcastRoundtrip.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist-test/integration/index.cjs && xvfb-run -a node test/integration/runner.mjs",
    "package": "vsce package --no-dependencies",
    "publish:vscode": "vsce publish --no-dependencies",
    "publish:ovsx": "ovsx publish --no-dependencies"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "vscode-messenger": "^0.6.1",
    "vscode-messenger-common": "^0.6.1",
    "vscode-messenger-webview": "^0.6.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^2.24.0",
    "chokidar": "^3.6.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.57.0",
    "ovsx": "^0.9.0",
    "playwright-core": "^1.61.1",
    "prettier": "^3.2.0",
    "sharp": "^0.34.5",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
